{
  "name": "marathon-archive",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "check:pages-size": "node tools/check-pages-size.mjs public",
    "clean": "node scripts/clean-static.mjs",
    "convert:png-webp": "python tools/convert-png-to-webp.py",
    "deploy": "npm run build",
    "preview": "npm run clean && npm run build && npm run check:pages-size && python tools/serve-public.py",
    "serve:public": "python tools/serve-public.py"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.2.9"
  }
}
